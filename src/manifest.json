{
  "manifest_version": 3,
  "name": "Zilvo Analyze — Company Classifier",
  "version": "2.0.0",
  "description": "Classify companies from LinkedIn URLs using AI.",

  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Zilvo Analyze"
  },

  "background": {
    "service_worker": "background.js"
  },

  "permissions": [
    "tabs",
    "scripting",
    "storage"
  ],

  "host_permissions": [
    "https://*.linkedin.com/*",
    "<all_urls>"
  ]
}
