{
  "manifest_version": 3,
  "name": "Zilvo Analyze",
  "version": "1.1.0",
  "description": "Company Intelligence: analyze companies from LinkedIn or any website and send data to Zilvo AI.",

  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Zilvo Analyze"
  },

  "side_panel": {
    "default_path": "popup.html"
  },

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],

  "content_scripts": [
    {
      "matches": ["https://zilvo.co/*", "https://www.zilvo.co/*", "http://localhost:3000/*"],
      "js": ["content_zilvo.js"],
      "run_at": "document_idle"
    }
  ],

  "host_permissions": [
    "https://*.linkedin.com/*",
    "https://zilvo.co/*",
    "https://www.zilvo.co/*",
    "http://localhost:3000/*",
    "<all_urls>"
  ]
}
